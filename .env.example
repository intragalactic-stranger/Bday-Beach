# Personalise the surprise: copy this file to `.env` and fill in your partner's details.
# These are baked into the site at build time (they are visible to anyone who opens it).

# Name carved into the sand and shown on the opening screen
VITE_PARTNER_NAME="Your Love"

# Birthday as YYYY-MM-DD. The age (e.g. "20th") is worked out automatically.
VITE_BIRTH_DATE="2006-01-01"

# Birth time, 24-hour HH:MM (or "5:42 AM"). Shown as e.g. "5:42 AM".
VITE_BIRTH_TIME="05:42"
